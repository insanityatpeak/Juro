# ============================================================================
# Juro — backend environment. Copy to `.env`. NEVER commit `.env`.
# ============================================================================

# --- LLM (local debate generator) -------------------------------------------
# The only key you need to generate a real debate for the UI.
# Models are LIGHT on purpose (claude-haiku-4-5) to keep cost/latency low.
ANTHROPIC_API_KEY=

# Optional model overrides (defaults are set in src/juro/agents.py).
# VERDICT_MODEL=claude-haiku-4-5
# VERDICT_ADJUDICATOR_MODEL=claude-haiku-4-5   # bump to claude-sonnet-4-6 for hard cases

# NOTE: the Deepgram TTS key powers the browser voices via /api/speak — put it in
# web/.env.local as DEEPGRAM_API_KEY=... (gitignored), NOT here.

# --- Band / thenvoi platform (submission path only) -------------------------
# User API key (thnv_u_...) — used to register agents + create the tribunal room.
# Get it from https://app.band.ai → settings. See docs/BAND_SETUP.md.
THENVOI_API_KEY=
THENVOI_REST_URL=https://app.band.ai
THENVOI_WS_URL=wss://app.band.ai/api/v1/socket/websocket

# --- Partner APIs (OPTIONAL — integration-ready, not required) ---------------
# Both are OpenAI-compatible, so wiring a key here routes agents through them
# with no code change. We are NOT chasing the partner prizes, but the code is
# ready if credits become available. Leave blank to run purely on Anthropic.
# AIMLAPI_API_KEY=
# AIMLAPI_BASE_URL=https://api.aimlapi.com/v1
# FEATHERLESS_API_KEY=
# FEATHERLESS_BASE_URL=https://api.featherless.ai/v1

# --- Auto-populated by the Band provisioning step ---------------------------
# THENVOI_AGENT_ID=
# VERDICT_TRIBUNAL_ROOM_ID=
