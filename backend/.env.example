# ============================================================================
# Juro — backend environment. Copy to `.env`. NEVER commit `.env`.
# ============================================================================

# --- LLM: Groq free tier only (no paid services) ------------------------------
# The Band agents run on Groq's FREE plan. Use a dedicated Groq account on the
# Free plan with NO payment method and NO paid upgrade, so usage can't be billed.
# All three switches are required; any one missing keeps the agents from starting.
JURO_LIVE_PROVIDER=groq
GROQ_API_KEY=
# Set to 1 only after confirming the account above is Free with no payment method.
JURO_GROQ_FREE_CONFIRMED=

# One model for all four roles. Confirm it is listed on your Free plan's limits page.
# GROQ_MODEL=openai/gpt-oss-20b

# When the free quota runs out, the agent posts a "[tribunal notice]" pause to the
# reviewer and stops. There is no paid fallback. @mention that agent to resume.

# Anthropic is blocked in code (juro.providers); ANTHROPIC_API_KEY is ignored.

# --- Band / thenvoi platform (submission path only) -------------------------
# User API key (thnv_u_...) — used to register agents + create the tribunal room.
# Get it from https://app.band.ai → settings. See docs/BAND_SETUP.md.
THENVOI_API_KEY=
THENVOI_REST_URL=https://app.band.ai
THENVOI_WS_URL=wss://app.band.ai/api/v1/socket/websocket

# --- Auto-populated by band_runner (setup / case) ----------------------------
# THENVOI_AGENT_ID=
# VERDICT_TRIBUNAL_ROOM_ID=
# VERDICT_CASE_ID=
